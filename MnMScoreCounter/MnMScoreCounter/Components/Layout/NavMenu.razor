<div class="navigation">
    <button class="menu-toggle"
            type="button"
            title="@(isExpanded ? "Close navigation" : "Open navigation")"
            aria-label="@(isExpanded ? "Close navigation" : "Open navigation")"
            aria-expanded="@isExpanded"
            @onclick="ToggleSidebar">
        <MudIcon Icon="@Icons.Material.Filled.Menu" />
    </button>

    @if (isExpanded)
    {
        <button class="drawer-backdrop" type="button" aria-label="Close navigation" @onclick="CollapseSidebar"></button>
    }

    <aside class="sidebar-drawer @(isExpanded ? "is-expanded" : null)" aria-label="Main navigation">
        <a class="app-brand" href="" title="Uno Counter home" @onclick="CollapseSidebar">
            <MudIcon Icon="@Icons.Material.Filled.Home" />
            <span>Uno Counter</span>
        </a>

        <nav class="nav-links" @onclick="CollapseSidebar">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Game">
                <MudIcon Icon="@Icons.Material.Filled.SportsEsports" />
                <span>Game</span>
            </NavLink>
            <NavLink class="nav-link" href="players" title="Players">
                <MudIcon Icon="@Icons.Material.Filled.People" />
                <span>Players</span>
            </NavLink>
        </nav>
    </aside>
</div>

@code {
    private bool isExpanded;

    private void ToggleSidebar()
    {
        isExpanded = !isExpanded;
    }

    private void CollapseSidebar()
    {
        isExpanded = false;
    }
}
