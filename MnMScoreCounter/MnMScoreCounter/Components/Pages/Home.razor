@page "/"
@inject IPlayerService PlayerService
@inject IGameSessionService GameSessionService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<div class="w-100 p-3">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true" Class="mb-6 font-weight-bold" Style="color: var(--mud-palette-primary);">
        <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Large" Class="mr-2" />
        Uno Counter
    </MudText>

    <div class="d-flex justify-center w-100">
        <!-- Game Setup Card stretched fully or bounded cleanly -->
        <div style="width: 100%; max-width: 800px;">
            <MudCard Elevation="3" Class="rounded-lg d-flex flex-column justify-between p-4">
                <div>
                    <MudCardHeader Class="pa-0 mb-4">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">
                                <MudIcon Icon="@Icons.Material.Filled.PlayCircleFilled" Class="mr-2" />
                                Match Setup
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Select active participants and set the target limit to start playing.</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <!-- Target Max Score -->
                        <MudNumericField @bind-Value="maxScoreLimit" 
                                         Label="Target Score Limit (Game Over Trigger)" 
                                         HelperText="Default is 500 points. Game ends when a player exceeds this."
                                         Variant="Variant.Outlined" 
                                         Min="50" 
                                         Max="5000" 
                                         Step="50"
                                         Class="mb-6" />

                        <!-- Active Player Selection -->
                        <div class="d-flex align-center justify-between mb-2">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold m-0">Select Players (Min 2):</MudText>
                            <MudButton Href="/players" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.People" Size="Size.Small">
                                Manage Players
                            </MudButton>
                        </div>
                        
                        @if (players == null)
                        {
                            <div class="d-flex justify-center p-4">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                            </div>
                        }
                        else if (players.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Class="rounded-lg mb-4">
                                Please add at least 2 players in the Player Directory before setting up a match.
                                <div class="mt-2">
                                    <MudButton Href="/players" Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">
                                        Add Players Now
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                        else
                        {
                            <div class="border rounded-lg p-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                                @foreach (var p in players)
                                {
                                    <div class="d-flex align-center py-1">
                                        <MudCheckBox T="bool" 
                                                     Value="@selectedPlayerIds.Contains(p.Id)" 
                                                     ValueChanged="@((bool val) => TogglePlayerSelection(p.Id, val))" 
                                                     Color="Color.Primary" />
                                        <span class="mr-2" style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: @p.Color;"></span>
                                        <MudText Typo="Typo.body1">@p.Name</MudText>
                                    </div>
                                }
                            </div>
                        }
                    </MudCardContent>
                </div>
                <MudCardActions Class="pa-0 pt-6 d-flex justify-end">
                    <MudButton OnClick="StartGame" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.PlayArrow" 
                               Disabled="@(!CanStartGame())"
                               Class="px-6 rounded-pill shadow-lg">
                        Start Match
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </div>
    </div>
</div>

@code {
    private List<Player>? players;
    private HashSet<Guid> selectedPlayerIds = new();
    private int maxScoreLimit = 500;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlayers();
    }

    private async Task LoadPlayers()
    {
        players = await PlayerService.GetPlayersAsync();
        if (players != null)
        {
            // Clear selections of non-existent players
            selectedPlayerIds.IntersectWith(players.Select(p => p.Id));
        }
    }

    private void TogglePlayerSelection(Guid id, bool selected)
    {
        if (selected)
        {
            selectedPlayerIds.Add(id);
        }
        else
        {
            selectedPlayerIds.Remove(id);
        }
    }

    private bool CanStartGame()
    {
        return selectedPlayerIds.Count >= 2 && maxScoreLimit > 0;
    }

    private void StartGame()
    {
        if (!CanStartGame() || players == null) return;

        var activePlayers = players.Where(p => selectedPlayerIds.Contains(p.Id)).ToList();
        GameSessionService.StartNewGame(activePlayers, maxScoreLimit);
        
        Snackbar.Add("Game Started! Have fun!", Severity.Success);
        NavigationManager.NavigateTo("game");
    }
}
